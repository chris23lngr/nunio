// Pilot access, owned by @nunio/billing. @nunio/delegation meters usage against the Allowance.
model PilotEntitlement {
  studentId   String    @id
  student     User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  activatedAt DateTime  @default(now())
  revokedAt   DateTime?
  revokedBy   String?

  @@map("pilot_entitlement")
}

// The student's total included AI usage in micro-USD. Only the founder raises the limit.
model Allowance {
  studentId     String           @id
  student       User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  limitMicroUsd BigInt           @default(5000000)
  usedMicroUsd  BigInt           @default(0)
  heldMicroUsd  BigInt           @default(0)
  updatedAt     DateTime         @default(now()) @updatedAt
  grants        AllowanceGrant[]

  @@map("allowance")
}

// The founder's audit trail of Allowance increases.
model AllowanceGrant {
  id             String    @id @default(uuid())
  studentId      String
  allowance      Allowance @relation(fields: [studentId], references: [studentId], onDelete: Cascade)
  amountMicroUsd BigInt
  grantedBy      String
  grantedAt      DateTime  @default(now())

  @@index([studentId])
  @@map("allowance_grant")
}
