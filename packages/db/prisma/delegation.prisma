// Usage reservations, owned by @nunio/delegation: one row per metered call.
model UsageReservation {
  id               String            @id @default(uuid())
  studentId        String
  allowance        Allowance         @relation(fields: [studentId], references: [studentId], onDelete: Cascade)
  /// The Agent whose Budget the call also counts against; null outside an Agent's Run.
  agentId          String?
  /// The Run whose call it was, for the Run's cost; null outside a Run.
  runId            String?
  estimateMicroUsd BigInt
  actualMicroUsd   BigInt?
  status           ReservationStatus @default(reserved)
  reservedAt       DateTime          @default(now())
  settledAt        DateTime?
  // The operator who settled a held reservation by hand; null when meter settled it.
  settledBy        String?

  @@index([studentId, status])
  @@index([runId])
  @@map("usage_reservation")
}

/// reserved: the call is in flight. held: its outcome is unknown, so its estimate stays counted.
enum ReservationStatus {
  reserved
  settled
  released
  held

  @@map("reservation_status")
}

/// active: may act. paused: takes no further Actions but keeps its Grants. ended: Grants gone, history kept.
enum AgentState {
  active
  paused
  ended

  @@map("agent_state")
}

/// An ongoing delegation the student owns: a record plus the Temporal Schedule that starts its Runs (ADR-0006).
model Agent {
  id             String              @id
  studentId      String
  student        User                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// A pilot preset's name; null for a free-text Agent. The Agents cutover removes it.
  preset         String?
  name           String              @default("")
  /// Its Beschreibung, for telling it apart from the student's other Agents.
  description    String              @default("")
  emoji          String              @default("🤖")
  /// The student's Instructions, the only text its Runs follow as a request (ADR-0026).
  instructions   String              @default("")
  /// Its scope, kept after End removes its Grants: a Course, or one exam (with the exam's Course).
  courseId       String?
  obligationId   String?
  /// Its trigger: when its Schedule starts a Run, in the Plan's time zone. Täglich ("daily") or chosen Wochentage
  /// ("weekdays", ISO weekdays: 1 is Monday, 7 is Sunday), at a minute of the day (Uhrzeit).
  triggerRhythm   String             @default("daily")
  triggerWeekdays Int[]              @default([])
  triggerMinute   Int                @default(360)
  /// The Model its Runs run on, chosen from those Chat offers; null for a preset Agent, which makes no model calls.
  modelKey        String?
  model           CatalogModel?      @relation(fields: [modelKey], references: [key], onDelete: Restrict)
  state          AgentState          @default(active)
  /// Why it was Paused: by the student ("student"), by exhausting its Budget ("budget"), by all its Courses being Archived
  /// ("course_archived") or by losing its last Course ("no_course"). Only the student resumes it.
  pausedBy       String?
  /// The Budget: its monthly cap on AI usage in micro-USD, and what its Runs have used and hold.
  budgetMicroUsd BigInt
  usedMicroUsd   BigInt              @default(0)
  heldMicroUsd   BigInt              @default(0)
  /// The month "YYYY-MM", in the Plan's time zone, whose usage `usedMicroUsd` counts; null before any. The Budget starts
  /// over at 00:00 on the 1st: used is cleared, held kept.
  budgetMonth    String?
  /// Advanced Agent configuration, compiled into Restrictions that can only tighten its Grants.
  restrictions   Json                @default("{}")
  createdAt      DateTime            @default(now())
  endedAt        DateTime?

  grants       Grant[]
  runs         Run[]
  courses      AgentCourse[]
  capabilities AgentCapability[]

  @@unique([id, studentId])
  @@index([studentId])
  @@map("agent")
}

/// One of an Agent's Courses, its scope: possibly Archived, in which case the Agent only reads it.
model AgentCourse {
  agentId   String
  courseId  String
  studentId String
  agent     Agent  @relation(fields: [agentId, studentId], references: [id, studentId], onDelete: Cascade)
  course    Course @relation(fields: [courseId, studentId], references: [id, studentId], onDelete: Cascade)

  @@id([agentId, courseId])
  @@index([studentId, courseId])
  @@map("agent_course")
}

/// How an Action Capability is authorised: always asked (ask), or held as a Grant that asks in fixed cases (automatic) or never (always).
enum ApprovalMode {
  always
  automatic
  ask

  @@map("approval_mode")
}

/// One of an Agent's Capabilities, by its id in the capability set in code. An Action Capability has a mode; any other has none.
model AgentCapability {
  agentId    String
  capability String
  studentId  String
  mode       ApprovalMode?
  agent      Agent         @relation(fields: [agentId, studentId], references: [id, studentId], onDelete: Cascade)

  @@id([agentId, capability])
  @@map("agent_capability")
}

/// Standing authority for one kind of Action across the Agent's Courses (a preset Agent's Grant is still scoped to one Course or Obligation); Grants exist only within an Agent.
model Grant {
  id               String         @id
  studentId        String
  agentId          String
  agent            Agent          @relation(fields: [agentId, studentId], references: [id, studentId], onDelete: Cascade)
  kind             String
  courseId         String?
  obligationId     String?

  @@index([agentId])
  @@map("grant")
}

/// A single, bounded execution of Agent work: one workflow (ADR-0006).
model Run {
  id               String          @id
  studentId        String
  student          User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// Null for a Run the student started, which has no Grants.
  agentId          String?
  agent            Agent?          @relation(fields: [agentId, studentId], references: [id, studentId], onDelete: Cascade)
  /// The Chat a student's Run was started from, if any.
  chatId           String?
  chat             Chat?           @relation(fields: [chatId, studentId], references: [id, studentId], onDelete: Cascade)
  /// The Temporal workflow running it, which the API signals once the student decides on one of its Actions.
  workflowId       String?
  startedAt        DateTime        @default(now())
  /// A free-text Agent's Run records the rest; null for preset, Chat and Artifact Runs.
  status           RunStatus?
  trigger          RunTrigger?
  endedAt          DateTime?
  /// Why a stopped Run stopped, such as paused, budget_exhausted or model_unavailable.
  stopReason       String?
  /// The Agent's configuration as the Run started: its Instructions, Capabilities and Model. Its Courses are pinned.
  instructions     String?
  capabilities     Json?
  modelKey         String?
  /// The model's final message, plain text, sealed under every Source the Run read; null without one.
  summaryContent   Bytes?
  summaryKey       Bytes?
  derivedFrom      String[]        @default([])

  actions  Action[]
  pin      RunPin?
  artifact Artifact?
  steps    RunStep[]
  events   RunEvent[]

  @@unique([id, studentId])
  @@index([studentId])
  @@index([agentId, status])
  @@map("run")
}

/// running: the model is working. stopped: Paused, Ended, out of Budget or Allowance, or its Model unavailable.
enum RunStatus {
  running
  done
  stopped
  failed

  @@map("run_status")
}

enum RunTrigger {
  schedule
  manual

  @@map("run_trigger")
}

/// One model step of an Agent's Run, idempotent on (runId, n): claimed before its model call, filled in once it returned.
/// Both texts are sealed under the Sources read so far; a claim without parts is a step that never finished.
model RunStep {
  runId             String
  n                 Int
  studentId         String
  run               Run      @relation(fields: [runId, studentId], references: [id, studentId], onDelete: Cascade)
  /// The model answered instead of calling a tool, so the Run's work is done.
  answered          Boolean  @default(false)
  /// What the student may see of the step: its tool calls, each with what it showed.
  partsContent      Bytes?
  partsKey          Bytes?
  /// The step's model messages, which later steps are given; dropped when the Run ends.
  transcriptContent Bytes?
  transcriptKey     Bytes?
  derivedFrom       String[] @default([])
  /// Its Action calls in order, each the Action the gate performs under `runId:step:call`, or why none was asked.
  calls             Json?
  /// The handles the step's tools gave out so far, such as O1 or B1, which later steps name work and blocks by.
  handles           Json?
  createdAt         DateTime @default(now())

  @@id([runId, n])
  @@map("run_step")
}

/// One Activity event of a Run's Verlauf (#149): what a step read, or what became of one of its Action calls. Append-only
/// and structured, never model text; it lives as long as its Run. The Verlauf's start and end come from the Run itself.
model RunEvent {
  /// Orders the Run's events as they were written.
  id        BigInt   @id @default(autoincrement())
  runId     String
  studentId String
  run       Run      @relation(fields: [runId, studentId], references: [id, studentId], onDelete: Cascade)
  /// Unique within the Run, so an Activity repeated after a lost completion writes nothing twice.
  key       String
  at        DateTime @default(now())
  /// read or action.
  type      String
  /// Ids, counts and outcomes only; names are looked up when shown.
  detail    Json

  @@unique([runId, key])
  @@map("run_event")
}

enum ActionStatus {
  awaiting_approval
  dispatching
  done
  failed
  refused
  unconfirmed

  @@map("action_status")
}

/// One concrete effect a Run or Chat asked the gate for, recorded under the caller's deterministic key.
model Action {
  id          String       @id
  studentId   String
  student     User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// Null for an Action asked for in a Chat.
  runId       String?
  run         Run?         @relation(fields: [runId, studentId], references: [id, studentId], onDelete: Cascade)
  key         String
  kind        String
  args        Json
  status      ActionStatus
  refusal     String?
  /// Why the executor definitely did not take the effect.
  failure     String?
  effect      Json?
  /// The authority it was dispatched on: one of the two.
  grantId     String?
  approvalId  String?
  createdAt   DateTime     @default(now())

  approval Approval?
  attempts Attempt[]
  events   ActionEvent[]

  @@unique([studentId, key])
  @@unique([id, studentId])
  @@index([runId])
  @@map("action")
}

/// The request for, and the student's answer to, their Approval of one exact Action, bound to the fingerprint shown.
model Approval {
  id          String    @id
  studentId   String
  actionId    String    @unique
  action      Action    @relation(fields: [actionId, studentId], references: [id, studentId], onDelete: Cascade)
  fingerprint String
  expiresAt   DateTime
  /// approved or denied; null while unanswered.
  decision    String?
  decidedAt   DateTime?

  @@unique([actionId, studentId])
  @@index([studentId])
  @@map("approval")
}

enum AttemptStatus {
  in_flight
  done
  failed
  unconfirmed

  @@map("attempt_status")
}

/// One dispatch to an executor. An in-flight row is the outbox: recovery asks the executor about its key.
model Attempt {
  id             String        @id
  studentId      String
  actionId       String
  action         Action        @relation(fields: [actionId, studentId], references: [id, studentId], onDelete: Cascade)
  idempotencyKey String        @unique
  status         AttemptStatus @default(in_flight)
  startedAt      DateTime
  finishedAt     DateTime?

  @@index([status, startedAt])
  @@map("attempt")
}

/// Append-only history of an Action, written in the same transaction as each change.
model ActionEvent {
  id        String   @id @default(uuid())
  studentId String
  actionId  String
  action    Action   @relation(fields: [actionId, studentId], references: [id, studentId], onDelete: Cascade)
  at        DateTime
  type      String
  detail    Json     @default("{}")

  @@index([actionId, at])
  @@map("action_event")
}
