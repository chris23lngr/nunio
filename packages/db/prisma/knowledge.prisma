// Source lifecycle and encrypted passages, owned by @nunio/knowledge.
model Source {
  id            String    @id
  studentId     String
  student       User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title         String
  bytes         Int
  status        SourceStatus @default(uploading)
  /// Why processing stopped, when the student can act on it; null for internal failures.
  failure       SourceFailure?
  keyVersion    String?
  keyCiphertext String?
  createdAt     DateTime  @default(now())
  uploadExpiresAt DateTime
  deletedAt     DateTime?
  extraction    ExtractionStatus @default(pending)
  extractedAt   DateTime?
  /// When the student last asked to extract again; a re-extraction is timed from here, not from the upload.
  extractionRequestedAt DateTime?
  /// The Course the student bound it to at upload or by "Kurs ändern"; null means nunio recognizes its Courses.
  /// Binding: extraction puts everything it finds under this Course. Deleting the Course nulls only courseId (the
  /// migration's SET NULL ("courseId")), so the Source stays (ADR-0015).
  courseId      String?
  course        Course?   @relation(fields: [courseId, studentId], references: [id, studentId], onDelete: SetNull)

  chunks      SourceChunk[]
  courses     SourceCourse[]
  obligations ObligationExtraction[]
  facts       FactExtraction[]
  chats       ChatSource[]
  runPins     RunPinSource[]

  @@unique([id, studentId])
  @@index([studentId, deletedAt])
  @@index([courseId])
  @@map("source")
}

enum SourceStatus {
  uploading
  queued
  processing
  ready
  failed
  deleted

  @@map("source_status")
}

model SourceChunk {
  id         String @id
  sourceId   String
  studentId  String
  source     Source @relation(fields: [sourceId, studentId], references: [id, studentId], onDelete: Cascade)
  page       Int
  ordinal    Int
  ciphertext Bytes
  model      String
  dimensions Int
  embedding  Unsupported("vector")

  @@unique([sourceId, ordinal])
  @@index([studentId, sourceId])
  @@map("source_chunk")
}

enum SourceFailure {
  too_many_pages
  too_large
  unreadable
  no_text
  allowance_exhausted

  @@map("source_failure")
}

enum ExtractionStatus {
  pending
  running
  done
  failed

  @@map("extraction_status")
}

model Course {
  id         String       @id
  studentId  String
  student    User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  code       String?
  title      String
  matchCode  String?
  matchTitle String
  status     CourseStatus @default(proposed)
  /// The Semester the student takes it in, such as "2026-ws" or "2027-ss".
  semester   String
  /// A palette name, not a CSS value.
  color      String
  /// Set for a Course the student created; its match keys follow its name.
  enteredAt  DateTime?
  /// Set while Archived: nunio neither plans nor acts for it.
  archivedAt DateTime?
  /// Set when merged: a later Source naming this Course lands in the target.
  mergedIntoId String?
  mergedInto   Course?    @relation("merge", fields: [mergedIntoId, studentId], references: [id, studentId], onDelete: Cascade)
  merged       Course[]   @relation("merge")
  createdAt  DateTime     @default(now())

  sources     SourceCourse[]
  obligations Obligation[]
  tasks       Task[]
  eventSeries EventSeries[]
  facts       Fact[]
  chats       ChatCourse[]
  runPins     RunPinCourse[]
  priorities  Priority[]
  preference  CoursePreference?
  projects    ProjectCourse[]
  boundSources Source[]
  distinctFrom DistinctCoursePair[] @relation("distinct")
  distinctTo   DistinctCoursePair[] @relation("distinctOther")

  @@unique([id, studentId])
  @@index([studentId])
  @@map("course")
}

/// Two Courses the student said are different ("Nein, verschieden"), so Review never suggests merging them again.
/// Stored once per pair, with courseId < otherId.
model DistinctCoursePair {
  studentId String
  courseId  String
  otherId   String
  course    Course   @relation("distinct", fields: [courseId, studentId], references: [id, studentId], onDelete: Cascade)
  other     Course   @relation("distinctOther", fields: [otherId, studentId], references: [id, studentId], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([courseId, otherId])
  @@index([studentId])
  @@index([otherId])
  @@map("distinct_course_pair")
}

enum CourseStatus {
  proposed
  accepted
  rejected
  merged

  @@map("course_status")
}

model SourceCourse {
  sourceId  String
  courseId  String
  studentId String
  source    Source @relation(fields: [sourceId, studentId], references: [id, studentId], onDelete: Cascade)
  course    Course @relation(fields: [courseId, studentId], references: [id, studentId], onDelete: Cascade)

  @@id([sourceId, courseId])
  @@index([studentId, courseId])
  @@map("source_course")
}

enum ReviewState {
  unreviewed
  confirmed
  rejected

  @@map("review_state")
}

enum ObligationKind {
  exam
  assignment
  presentation
  thesis
  registration
  other

  @@map("obligation_kind")
}

/// Why a corrected item has no extraction left; it stays because the Correction is the student's own.
enum Unsupported {
  source_deleted
  not_found

  @@map("unsupported")
}

/// Where an extraction's quote was found: the page's own text, or only a figure description the scan model wrote.
enum Grounding {
  text
  figure

  @@map("grounding")
}

/// One item per Course and key; review state and the Correction live here, never on an extraction.
/// A Correction is the student's own value in plain columns, present when correctedAt is set.
model Obligation {
  id                   String         @id
  studentId            String
  courseId             String
  course               Course         @relation(fields: [courseId, studentId], references: [id, studentId], onDelete: Cascade)
  matchKey             String
  kind                 ObligationKind
  state                ReviewState    @default(unreviewed)
  correctedAt          DateTime?
  correctedTitle       String?
  correctedDueDate     DateTime?      @db.Date
  correctedDueTime     String?
  correctedTimeZone    String?
  correctedDestination String?
  /// Set for an Obligation the student entered by hand (Provenance entry); its values live in the corrected* columns.
  enteredAt            DateTime?
  /// Reported as Submitted: the student says they handed it in through a Handoff; nunio cannot verify it.
  reportedSubmittedAt  DateTime?
  unsupported          Unsupported?
  createdAt            DateTime       @default(now())

  extractions ObligationExtraction[]
  tasks       Task[]
  estimate    ObligationEstimate?
  studyBlocks StudyBlock[]
  projects    Project[]
  priorities  Priority[]

  @@unique([id, studentId])
  @@unique([courseId, matchKey])
  @@index([studentId, courseId])
  @@map("obligation")
}

// Structure is plain for planning and matching; wording is encrypted under the Source key.
model ObligationExtraction {
  id           String     @id
  studentId    String
  obligationId String
  sourceId     String
  obligation   Obligation @relation(fields: [obligationId, studentId], references: [id, studentId], onDelete: Cascade)
  source       Source     @relation(fields: [sourceId, studentId], references: [id, studentId], onDelete: Cascade)
  page         Int
  dueDate      DateTime?  @db.Date
  dueTime      String?
  timeZone     String?
  ciphertext   Bytes
  /// Set by "Use this" or Keep mine: this value no longer counts towards a Disagreement.
  overruledAt  DateTime?
  createdAt    DateTime   @default(now())

  @@index([obligationId])
  @@index([sourceId])
  @@map("obligation_extraction")
}

enum FactType {
  topic
  course_rule
  exam_logistics
  /// Whether AI may be used for assessed work: the value is forbidden, conditional or allowed.
  ai_use_rule

  @@map("fact_type")
}

model Fact {
  id             String       @id
  studentId      String
  courseId       String
  course         Course       @relation(fields: [courseId, studentId], references: [id, studentId], onDelete: Cascade)
  type           FactType
  matchKey       String
  state          ReviewState  @default(unreviewed)
  correctedAt    DateTime?
  correctedValue String?
  unsupported    Unsupported?
  createdAt      DateTime     @default(now())

  extractions     FactExtraction[]
  selfAssessments SelfAssessment[]

  @@unique([id, studentId])
  @@unique([courseId, type, matchKey])
  @@index([studentId, courseId])
  @@map("fact")
}

model FactExtraction {
  id          String    @id
  studentId   String
  factId      String
  sourceId    String
  fact        Fact      @relation(fields: [factId, studentId], references: [id, studentId], onDelete: Cascade)
  source      Source    @relation(fields: [sourceId, studentId], references: [id, studentId], onDelete: Cascade)
  page        Int
  grounding   Grounding @default(text)
  ciphertext  Bytes
  overruledAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([factId])
  @@index([sourceId])
  @@map("fact_extraction")
}

/// A Chat's explicit selection of Courses and Sources; an empty selection means no material.
model Chat {
  id        String   @id
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  /// When the student last asked or decided proposals in it (Last Activity); null until the first question is saved.
  lastActivityAt DateTime?

  courses  ChatCourse[]
  sources  ChatSource[]
  messages ChatMessage[]
  runs     Run[]

  @@unique([id, studentId])
  @@index([studentId])
  @@index([studentId, lastActivityAt(sort: Desc), id(sort: Desc)])
  @@map("chat")
}

model ChatCourse {
  chatId    String
  courseId  String
  studentId String
  chat      Chat   @relation(fields: [chatId, studentId], references: [id, studentId], onDelete: Cascade)
  course    Course @relation(fields: [courseId, studentId], references: [id, studentId], onDelete: Cascade)

  @@id([chatId, courseId])
  @@map("chat_course")
}

model ChatSource {
  chatId    String
  sourceId  String
  studentId String
  chat      Chat   @relation(fields: [chatId, studentId], references: [id, studentId], onDelete: Cascade)
  source    Source @relation(fields: [sourceId, studentId], references: [id, studentId], onDelete: Cascade)

  @@id([chatId, sourceId])
  @@map("chat_source")
}

enum ChatRole {
  student
  assistant

  @@map("chat_role")
}

/// Citations are stored as CitationRefs only, never snippets, and resolved at display time.
/// An answer drawn from Sources is encrypted under its own key, wrapped in turn under each of those Sources' keys,
/// so deleting any of them shreds it (ADR-0007); a question or an answer drawn from no Source is plain UTF-8.
model ChatMessage {
  id          String   @id
  chatId      String
  studentId   String
  chat        Chat     @relation(fields: [chatId, studentId], references: [id, studentId], onDelete: Cascade)
  role        ChatRole
  content     Bytes
  /// Reasoning uses its own key with the same Source dependencies as the answer.
  reasoningContent Bytes?
  reasoningKey Bytes?
  /// The answer's ordered parts as the student saw them, with the same Source dependencies; null for questions and older answers.
  partsContent Bytes?
  partsKey Bytes?
  /// The message key, wrapped under each `derivedFrom` Source's key in order; null when derived from none.
  contentKey  Bytes?
  /// The Sources whose passages the answer was given, in wrapping order.
  derivedFrom String[] @default([])
  /// [{ tag, cite }] for the citation tags in the text.
  citations   Json     @default("[]")
  /// The Model Catalog key that wrote an assistant answer; null for questions and older answers.
  modelKey    String?
  model       CatalogModel? @relation(fields: [modelKey], references: [key], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@index([chatId, createdAt])
  @@map("chat_message")
}

/// A student's own query vectors, so a repeated question is neither embedded nor metered again. Holds no course material.
model QueryEmbedding {
  studentId  String
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  model      String
  /// SHA-256 of the whitespace-normalized query text.
  queryHash  String
  dimensions Int
  embedding  Unsupported("vector")
  createdAt  DateTime @default(now())

  @@id([studentId, model, queryHash])
  @@map("query_embedding")
}

/// An optional, outcome-oriented workspace related to zero or more Courses and optionally one Obligation.
model Project {
  id           String      @id
  studentId    String
  student      User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name         String
  obligationId String?
  obligation   Obligation? @relation(fields: [obligationId, studentId], references: [id, studentId], onDelete: SetNull)
  createdAt    DateTime    @default(now())

  courses    ProjectCourse[]
  priorities Priority[]

  @@unique([id, studentId])
  @@index([studentId])
  @@map("project")
}

model ProjectCourse {
  projectId String
  courseId  String
  studentId String
  project   Project @relation(fields: [projectId, studentId], references: [id, studentId], onDelete: Cascade)
  course    Course  @relation(fields: [courseId, studentId], references: [id, studentId], onDelete: Cascade)

  @@id([projectId, courseId])
  @@map("project_course")
}

/// A Run's selection, fixed when the student started it: Sources and Facts added later stay out, removals apply live.
model RunPin {
  runId     String   @id
  studentId String
  run       Run      @relation(fields: [runId, studentId], references: [id, studentId], onDelete: Cascade)
  pinnedAt  DateTime @default(now())

  courses RunPinCourse[]
  sources RunPinSource[]

  @@unique([runId, studentId])
  @@map("run_pin")
}

/// A pinned Course: the Run reads its Facts.
model RunPinCourse {
  runId     String
  courseId  String
  studentId String
  pin       RunPin @relation(fields: [runId, studentId], references: [runId, studentId], onDelete: Cascade)
  course    Course @relation(fields: [courseId, studentId], references: [id, studentId], onDelete: Cascade)

  @@id([runId, courseId])
  @@map("run_pin_course")
}

/// A pinned Source, chosen directly or through a pinned Course when the Run started: the Run reads its passages.
model RunPinSource {
  runId     String
  sourceId  String
  studentId String
  pin       RunPin @relation(fields: [runId, studentId], references: [runId, studentId], onDelete: Cascade)
  source    Source @relation(fields: [sourceId, studentId], references: [id, studentId], onDelete: Cascade)

  @@id([runId, sourceId])
  @@map("run_pin_source")
}
