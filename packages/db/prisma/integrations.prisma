// The Integration catalog (#280), owned by @nunio/integrations. Its rows are seeded and changed through migrations;
// dev and test databases get offered Integrations from the seed helper in @nunio/integrations/testing.
model Integration {
  key                String   @id
  name               String
  /// The path of its logo in the web app, such as /integrations/email.svg.
  logo               String
  description        String
  /// Where the vendor processes data, shown on Verfügbar and in the Connect dialog.
  dataNote           String
  /// hidden (seeded, not offered), offered or withdrawn.
  status             String   @default("hidden")
  /// mcp, or email for nunio's own IMAP and SMTP tools.
  kind               String
  /// The MCP server's URL; mcp only, like the columns below.
  mcpUrl             String?
  /// http (Streamable HTTP) or sse.
  transport          String?
  /// Every scope, asked up front.
  scopes             String[] @default([])
  /// The authorization server issuers nunio accepts from the server's Protected Resource Metadata.
  issuers            String[] @default([])
  /// cimd, dcr or preregistered.
  registration       String?
  /// For preregistered: the names of the platform secrets holding the client id and secret.
  clientIdSecret     String?
  clientSecretSecret String?
  createdAt          DateTime @default(now())

  tools       IntegrationTool[]
  connections Connection[]

  @@map("integration")
}

// A tool nunio reviewed and classified. A server's tool without a row is unclassified and never offered.
model IntegrationTool {
  integrationKey   String
  integration      Integration @relation(fields: [integrationKey], references: [key])
  /// The server's own tool name.
  name             String
  /// read, write, write_always_asked or blocked (#262).
  class            String
  /// The pinned definition, { description, inputSchema }, as reviewed.
  definition       Json
  /// sha256 of the definition's canonical JSON.
  definitionHash   String
  /// nunio's German label, such as "Mail senden".
  label            String
  /// The argument an Approval card shows first.
  headlineArgument String?
  /// Offered only in a Chat, never to an Agent (only email.submit).
  chatOnly         Boolean     @default(false)
  /// When staff last reviewed the server's live definition; null for nunio's own tools.
  reviewedAt       DateTime?

  @@id([integrationKey, name])
  @@map("integration_tool")
}

// A student's Connection to an Integration (#261): at most one per student and Integration. Its credentials sit in
// connection_credential; everything nunio stores from it is sealed under its content key, wrapped like a Source key.
model Connection {
  id             String      @id
  studentId      String
  student        User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  integrationKey String
  integration    Integration @relation(fields: [integrationKey], references: [key])
  /// connected or needs_reconnection.
  state          String      @default("connected")
  /// Why it needs reconnection; null while connected.
  stateCause     String?
  /// Since when it is in its state.
  stateSince     DateTime    @default(now())
  /// The account shown, such as the email address.
  accountLabel   String
  /// Email: the folders nunio may read, by IMAP path.
  folders        String[]    @default([])
  /// Email: the IMAP and SMTP hosts and ports nunio resolved, { imap: { host, port }, smtp: { host, port } }.
  servers        Json?
  /// The content key, wrapped under the Source master key of this version.
  keyVersion     String
  keyCiphertext  String
  createdAt      DateTime    @default(now())
  lastUsedAt     DateTime?

  credential ConnectionCredential?

  @@unique([studentId, integrationKey])
  @@unique([id, studentId])
  @@map("connection")
}

// A Connection's credentials (ADR-0007 amendment), sealed directly under the "connection credentials" master key.
// No route returns them and no Temporal payload carries them.
model ConnectionCredential {
  connectionId String     @id
  studentId    String
  connection   Connection @relation(fields: [connectionId, studentId], references: [id, studentId], onDelete: Cascade)
  /// The master key version they are sealed under.
  keyVersion   String
  ciphertext   String
  createdAt    DateTime   @default(now())

  @@unique([connectionId, studentId])
  @@map("connection_credential")
}

// Mailbox logins a student made in the current fixed window; testing and connecting Email count against it.
model MailLoginLimit {
  studentId   String @id
  student     User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  count       Int
  /// When the window began, in milliseconds since the epoch.
  windowStart BigInt

  @@map("mail_login_limit")
}
