// Interventions nunio raises toward the student. Phase 10 builds the inbox, Briefings and delivery on these records.

/// Something nunio initiates that asks for the student's attention or a decision. Never an Action.
model Intervention {
  id             String    @id
  studentId      String
  student        User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// shortfall, disagreement, approval_expired or unconfirmed.
  kind           String
  /// Its cause, such as `shortfall:<workId>`; one open Intervention per cause (a partial unique index in SQL).
  dedupeKey      String
  actionId       String?
  createdAt      DateTime  @default(now())
  /// Seen or acknowledged; distinct from a Dismissal, which means it was not useful.
  acknowledgedAt DateTime?
  dismissedAt    DateTime?
  /// When its cause stopped holding; a Lapse when neither acknowledged nor dismissed by then.
  causeEndedAt   DateTime?

  @@index([studentId, createdAt])
  @@map("intervention")
}

/// How the student wants to hear from nunio. Without a row, the defaults apply.
model OutreachSettings {
  studentId        String  @id
  student          User    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// Minutes after local midnight, in the Plan's time zone; null turns Briefings off.
  briefingAtMinute Int?    @default(420)
  /// The last local date a Briefing was due, made or skipped as empty.
  lastBriefingOn   String?
  /// Whether nunio emails the student; the Inbox has everything either way.
  email            Boolean @default(true)

  @@map("outreach_settings")
}

/// One message outside the app announcing an Intervention or a Briefing; settled once, as sent or dropped.
model Delivery {
  id             String    @id
  studentId      String
  student        User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// email for now.
  channel        String
  interventionId String?
  briefingId     String?
  dueAt          DateTime
  sentAt         DateTime?
  droppedAt      DateTime?
  /// closed or disabled.
  dropReason     String?

  @@index([studentId, dueAt])
  @@map("delivery")
}

/// A scheduled summary, never edited once made: which Interventions, Approvals and Responsibilities it bundled.
model Briefing {
  id        String   @id
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  localDate String
  createdAt DateTime @default(now())
  items     Json

  @@unique([studentId, localDate])
  @@map("briefing")
}
