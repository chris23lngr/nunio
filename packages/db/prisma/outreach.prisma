// Interventions nunio raises toward the student. Phase 10 builds the inbox, Briefings and delivery on these records.

/// Something nunio initiates that asks for the student's attention or a decision. Never an Action.
model Intervention {
  id             String    @id
  studentId      String
  student        User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// shortfall, disagreement, approval_expired, unconfirmed or run_approvals.
  kind           String
  /// Its cause, such as `shortfall:<workId>`; one open Intervention per cause (a partial unique index in SQL).
  dedupeKey      String
  actionId       String?
  createdAt      DateTime  @default(now())
  /// Seen or acknowledged; distinct from a Dismissal, which means it was not useful.
  acknowledgedAt DateTime?
  dismissedAt    DateTime?
  /// When its cause stopped holding; a Lapse when neither acknowledged nor dismissed by then.
  causeEndedAt   DateTime?

  @@index([studentId, createdAt])
  @@map("intervention")
}

/// How the student wants to hear from nunio. Without a row, the defaults apply.
model OutreachSettings {
  studentId        String  @id
  student          User    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// Whether nunio emails the student; the Inbox has everything either way.
  email            Boolean @default(true)
  /// Quiet Hours in minutes after local midnight, in the Plan's time zone; both null when off. May wrap midnight.
  quietFromMinute  Int?
  quietToMinute    Int?
  /// Announcements of Interventions, Notices and Agent Briefings per local day, email and push combined.
  dailyLimit       Int     @default(3)

  @@map("outreach_settings")
}

/// One message outside the app announcing an Intervention, a Notice or a Briefing; settled once, as sent or dropped.
model Delivery {
  id             String    @id
  studentId      String
  student        User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// email or push.
  channel        String
  interventionId String?
  noticeId       String?
  briefingId     String?
  dueAt          DateTime
  sentAt         DateTime?
  droppedAt      DateTime?
  /// closed, disabled or limit; closed also for a Notice read, or deleted, before it was announced.
  dropReason     String?

  @@index([studentId, dueAt])
  @@map("delivery")
}

/// A message an Agent wrote the student in a Run (#155), shown as the Agent's own words. Never an Intervention: it has
/// no cause, never lapses, and is unread until the student opens it. Its announcement is its Deliveries.
model Notice {
  id          String    @id
  studentId   String
  student     User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  agentId     String
  agent       Agent     @relation(fields: [agentId, studentId], references: [id, studentId], onDelete: Cascade)
  /// The Run that sent it; at most one per Run (ADR-0026).
  runId       String
  run         Run       @relation(fields: [runId, studentId], references: [id, studentId], onDelete: Cascade)
  /// Plain text of at most 500 characters, sealed under every Source the Run had read, as its summary is.
  textContent Bytes
  textKey     Bytes?
  derivedFrom String[]  @default([])
  /// The Connections it was drawn from, sealed after the Sources in wrapping order (#266).
  derivedFromConnections String[] @default([])
  createdAt   DateTime  @default(now())
  readAt      DateTime?

  @@unique([runId, studentId])
  @@index([studentId, createdAt])
  @@map("notice")
}

/// A summary an Agent wrote for the student in a Run (#146), together with the Inbox items it bundled, or a past
/// scheduled summary nunio wrote before Agents took Briefings over. Never edited once made.
model Briefing {
  id          String   @id
  studentId   String
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// Null for a past Briefing nunio wrote itself before Agents took Briefings over.
  agentId     String?
  agent       Agent?   @relation(fields: [agentId, studentId], references: [id, studentId], onDelete: Cascade)
  /// The Run that wrote it; at most one per Run (ADR-0026). Null for nunio's own past Briefings.
  runId       String?
  run         Run?     @relation(fields: [runId, studentId], references: [id, studentId], onDelete: Cascade)
  /// Only set on nunio's own past Briefings, which were one per local day.
  localDate   String?
  /// Plain text of at most 1,500 characters, sealed under every Source the Run had read; null on nunio's own past Briefings.
  textContent Bytes?
  textKey     Bytes?
  derivedFrom String[] @default([])
  /// The Connections it was drawn from, sealed after the Sources in wrapping order (#266).
  derivedFromConnections String[] @default([])
  createdAt   DateTime @default(now())
  items       Json

  @@unique([runId, studentId])
  @@index([studentId, createdAt])
  @@map("briefing")
}

/// One device's opt-in to empty push messages. The endpoint is a capability URL and never logged.
model PushSubscription {
  id             String    @id
  studentId      String
  student        User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  endpoint       String    @unique
  p256dh         String
  auth           String
  expirationTime DateTime?
  /// The public VAPID key it was created with; a rotated key needs every device to subscribe again.
  vapidKeyId     String
  createdAt      DateTime  @default(now())

  @@map("push_subscription")
}
