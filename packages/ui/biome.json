{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "extends": "//",
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "rules": {
      "nursery": {
        "useTailwindSortedClasses": {
          "level": "warn",
          "fix": "safe"
        }
      },
      "style": {
        "noNonNullAssertion": "warn"
      }
    }
  },
  "tailwind": {
    "stylesheet": "./src/styles/globals.css"
  }
}
