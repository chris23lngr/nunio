{
  "name": "@nunio/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "exports": {
    "./create-app": {
      "types": "./dist/create-app.d.ts",
      "default": "./dist/create-app.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "openapi": "tsx scripts/write-openapi.ts"
  },
  "dependencies": {
    "@nunio/billing": "workspace:*",
    "@hono/zod-openapi": "1.6.3",
    "@nunio/db": "workspace:*",
    "@nunio/delegation": "workspace:*",
    "@nunio/identity": "workspace:*",
    "@vercel/functions": "3.10.5",
    "hono": "4.13.14",
    "zod": "4.6.7",
    "@nunio/knowledge": "workspace:*",
    "@nunio/keys": "workspace:*",
    "@nunio/ai": "workspace:*",
    "@temporalio/client": "1.25.0",
    "@nunio/planning": "workspace:*",
    "@nunio/outreach": "workspace:*"
  },
  "devDependencies": {
    "@temporalio/testing": "1.25.0",
    "@hono/node-server": "2.1.5",
    "@nunio/typescript-config": "workspace:*",
    "@types/node": "24.19.2",
    "better-auth": "1.7.14",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "@biomejs/biome": "2.6.3"
  }
}
