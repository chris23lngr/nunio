{
  "openapi": "3.1.0",
  "info": {
    "title": "nunio API",
    "version": "0.0.0"
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "PilotEntitlement": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "none",
              "active",
              "revoked"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "Unauthorized": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "unauthorized"
            ]
          }
        },
        "required": [
          "error"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "responses": {
          "200": {
            "description": "The API is running.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/me/entitlement": {
      "get": {
        "responses": {
          "200": {
            "description": "The current student's pilot status. Active pilot access has no fixed expiry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PilotEntitlement"
                }
              }
            }
          },
          "401": {
            "description": "A current, verified session is required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Unauthorized"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
