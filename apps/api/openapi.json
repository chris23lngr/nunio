{
  "openapi": "3.1.0",
  "info": {
    "title": "nunio API",
    "version": "0.0.0"
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "PilotEntitlement": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "none",
              "active",
              "revoked"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "Unauthorized": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "unauthorized"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Allowance": {
        "type": "object",
        "properties": {
          "limitMicroUsd": {
            "type": "integer"
          },
          "usedMicroUsd": {
            "type": "integer"
          },
          "heldMicroUsd": {
            "type": "integer"
          }
        },
        "required": [
          "limitMicroUsd",
          "usedMicroUsd",
          "heldMicroUsd"
        ]
      },
      "DeletionPending": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pending"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "InvalidPassword": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "invalid_password"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "TooManyRequests": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "too_many_requests"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "DeletionRequest": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string"
          }
        },
        "required": [
          "password"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "responses": {
          "200": {
            "description": "The API is running.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/me/entitlement": {
      "get": {
        "responses": {
          "200": {
            "description": "The current student's pilot status. Active pilot access has no fixed expiry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PilotEntitlement"
                }
              }
            }
          },
          "401": {
            "description": "A current, verified session is required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Unauthorized"
                }
              }
            }
          }
        }
      }
    },
    "/api/me/allowance": {
      "get": {
        "responses": {
          "200": {
            "description": "The current student's Allowance in micro-USD: its limit, settled usage, and usage still held for calls in flight or of unknown outcome. Readable while the AI kill switch is on.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Allowance"
                }
              }
            }
          },
          "401": {
            "description": "A current, verified session is required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Unauthorized"
                }
              }
            }
          }
        }
      }
    },
    "/api/me/deletion-request": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeletionRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Deletion is queued for manual completion; every session of the student has ended.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeletionPending"
                }
              }
            }
          },
          "401": {
            "description": "A current, verified session is required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Unauthorized"
                }
              }
            }
          },
          "403": {
            "description": "The password does not match; nothing was recorded and sessions remain.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvalidPassword"
                }
              }
            }
          },
          "429": {
            "description": "Too many password attempts for this student; the password was not checked. Retry after 10 seconds.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TooManyRequests"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
