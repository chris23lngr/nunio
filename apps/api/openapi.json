{
  "openapi": "3.1.0",
  "info": {
    "title": "nunio API",
    "version": "0.0.0"
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "PilotEntitlement": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "none",
              "active",
              "revoked"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "Unauthorized": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "unauthorized"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Allowance": {
        "type": "object",
        "properties": {
          "limitMicroUsd": {
            "type": "integer"
          },
          "usedMicroUsd": {
            "type": "integer"
          },
          "heldMicroUsd": {
            "type": "integer"
          }
        },
        "required": [
          "limitMicroUsd",
          "usedMicroUsd",
          "heldMicroUsd"
        ]
      },
      "DeletionPending": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pending"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "InvalidPassword": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "invalid_password"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "TooManyRequests": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "too_many_requests"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "DeletionRequest": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string"
          }
        },
        "required": [
          "password"
        ]
      },
      "Source": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "uploading",
              "queued",
              "processing",
              "ready",
              "failed",
              "deleted"
            ]
          },
          "failure": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "too_many_pages",
              "too_large",
              "unreadable",
              "no_text",
              "allowance_exhausted",
              null
            ],
            "description": "Why processing stopped, when the student can act on it."
          },
          "extraction": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "done",
              "failed"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "status",
          "failure",
          "extraction"
        ]
      },
      "Course": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "code": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "accepted",
              "rejected"
            ]
          },
          "obligations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Obligation"
            }
          },
          "facts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Fact"
            }
          }
        },
        "required": [
          "id",
          "code",
          "title",
          "status",
          "obligations",
          "facts"
        ]
      },
      "Obligation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "unreviewed",
              "confirmed",
              "rejected"
            ]
          },
          "uncertainty": {
            "type": [
              "string",
              "null"
            ]
          },
          "provenance": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "correction"
                    ]
                  }
                },
                "required": [
                  "kind"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "source"
                    ]
                  },
                  "sourceId": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "page": {
                    "type": "integer"
                  },
                  "quote": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "sourceId",
                  "title",
                  "page",
                  "quote"
                ]
              }
            ]
          },
          "disagreement": {
            "type": "boolean",
            "description": "Values that are not overruled differ from each other or from the Correction."
          },
          "unsupported": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "source_deleted",
              "not_found",
              null
            ],
            "description": "Set when a corrected item lost its last extraction."
          },
          "kind": {
            "type": "string",
            "enum": [
              "exam",
              "assignment",
              "presentation",
              "thesis",
              "registration",
              "other"
            ]
          },
          "title": {
            "type": "string"
          },
          "due": {
            "type": "object",
            "properties": {
              "date": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "time": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "timeZone": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "text": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The Source's wording; null for a Correction."
              }
            },
            "required": [
              "date",
              "time",
              "timeZone",
              "text"
            ]
          },
          "destination": {
            "type": [
              "string",
              "null"
            ],
            "description": "As stated in the Source, or the student's Correction; never verified."
          },
          "values": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "due": {
                  "type": "object",
                  "properties": {
                    "date": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "time": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "timeZone": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "date",
                    "time",
                    "timeZone"
                  ]
                },
                "overruled": {
                  "type": "boolean"
                },
                "citations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "extractionId": {
                        "type": "string"
                      },
                      "sourceId": {
                        "type": "string"
                      },
                      "title": {
                        "type": "string"
                      },
                      "page": {
                        "type": "integer"
                      },
                      "quote": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "extractionId",
                      "sourceId",
                      "title",
                      "page",
                      "quote"
                    ]
                  }
                }
              },
              "required": [
                "due",
                "overruled",
                "citations"
              ]
            }
          }
        },
        "required": [
          "id",
          "state",
          "uncertainty",
          "provenance",
          "disagreement",
          "unsupported",
          "kind",
          "title",
          "due",
          "destination",
          "values"
        ]
      },
      "Fact": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "unreviewed",
              "confirmed",
              "rejected"
            ]
          },
          "uncertainty": {
            "type": [
              "string",
              "null"
            ]
          },
          "provenance": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "correction"
                    ]
                  }
                },
                "required": [
                  "kind"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "source"
                    ]
                  },
                  "sourceId": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "page": {
                    "type": "integer"
                  },
                  "quote": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "sourceId",
                  "title",
                  "page",
                  "quote"
                ]
              }
            ]
          },
          "disagreement": {
            "type": "boolean",
            "description": "Values that are not overruled differ from each other or from the Correction."
          },
          "unsupported": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "source_deleted",
              "not_found",
              null
            ],
            "description": "Set when a corrected item lost its last extraction."
          },
          "type": {
            "type": "string",
            "enum": [
              "topic",
              "course_rule",
              "exam_logistics"
            ]
          },
          "value": {
            "type": "string"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string"
                },
                "overruled": {
                  "type": "boolean"
                },
                "citations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "extractionId": {
                        "type": "string"
                      },
                      "sourceId": {
                        "type": "string"
                      },
                      "title": {
                        "type": "string"
                      },
                      "page": {
                        "type": "integer"
                      },
                      "quote": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "extractionId",
                      "sourceId",
                      "title",
                      "page",
                      "quote"
                    ]
                  }
                }
              },
              "required": [
                "value",
                "overruled",
                "citations"
              ]
            }
          }
        },
        "required": [
          "id",
          "state",
          "uncertainty",
          "provenance",
          "disagreement",
          "unsupported",
          "type",
          "value",
          "values"
        ]
      },
      "Correction": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "due": {
                "type": "object",
                "properties": {
                  "date": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "time": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "timeZone": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "date",
                  "time",
                  "timeZone"
                ]
              },
              "destination": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 500
              }
            },
            "required": [
              "title",
              "due",
              "destination"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "value"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "responses": {
          "200": {
            "description": "The API is running.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/me/entitlement": {
      "get": {
        "responses": {
          "200": {
            "description": "The current student's pilot status. Active pilot access has no fixed expiry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PilotEntitlement"
                }
              }
            }
          },
          "401": {
            "description": "A current, verified session is required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Unauthorized"
                }
              }
            }
          }
        }
      }
    },
    "/api/me/allowance": {
      "get": {
        "responses": {
          "200": {
            "description": "The current student's Allowance in micro-USD: its limit, settled usage, and usage still held for calls in flight or of unknown outcome. Readable while the AI kill switch is on.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Allowance"
                }
              }
            }
          },
          "401": {
            "description": "A current, verified session is required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Unauthorized"
                }
              }
            }
          }
        }
      }
    },
    "/api/me/deletion-request": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeletionRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Deletion is queued for manual completion; every session of the student has ended.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeletionPending"
                }
              }
            }
          },
          "401": {
            "description": "A current, verified session is required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Unauthorized"
                }
              }
            }
          },
          "403": {
            "description": "The password does not match; nothing was recorded and sessions remain.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvalidPassword"
                }
              }
            }
          },
          "429": {
            "description": "Too many password attempts for this student; the password was not checked. Retry after 10 seconds.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TooManyRequests"
                }
              }
            }
          }
        }
      }
    },
    "/api/me/sources": {
      "get": {
        "responses": {
          "200": {
            "description": "The student's live Sources.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Source"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Sign in required.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Pilot access is not active or deletion is pending.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Source is gone.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  },
                  "bytes": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 20971520
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "application/pdf"
                    ]
                  }
                },
                "required": [
                  "title",
                  "bytes",
                  "type"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Upload directly to quarantine using PUT and these headers.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "source": {
                      "$ref": "#/components/schemas/Source"
                    },
                    "upload": {
                      "type": "object",
                      "properties": {
                        "url": {
                          "type": "string"
                        },
                        "headers": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string"
                          }
                        },
                        "expiresAt": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "url",
                        "headers",
                        "expiresAt"
                      ]
                    }
                  },
                  "required": [
                    "source",
                    "upload"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Sign in required.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Pilot access is not active or deletion is pending.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Source is gone.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/me/sources/{id}/extract": {
      "post": {
        "description": "Read again: extract a ready Source anew.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "202": {
            "description": "Extraction queued and metered again; repeating while it waits is idempotent.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "queued"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Sign in required.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Pilot access is not active or deletion is pending.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Source is gone.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "409": {
            "description": "Extraction is running.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/me/sources/{id}/complete": {
      "post": {
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "202": {
            "description": "Ingestion queued; repeating is idempotent.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "queued"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Sign in required.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Pilot access is not active or deletion is pending.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Source is gone.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/me/sources/{id}": {
      "delete": {
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
